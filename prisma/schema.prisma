generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id             String            @id
  name           String
  email          String            @unique
  emailVerified  Boolean           @default(false)
  image          String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  sessions       Session[]
  accounts       Account[]
  memberships    WorkspaceMember[]
  ownedWorkspace Workspace?
}

model Session {
  id        String   @id
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@unique([providerId, accountId])
  @@index([userId])
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

model RateLimit {
  id          String @id
  key         String @unique
  count       Int
  lastRequest BigInt
}

enum Role {
  OWNER
  ADMIN
  STAFF
}

enum InvoiceStatus {
  DRAFT
  SENT
  PARTIALLY_PAID
  PAID
  VOID
}

enum DiscountType {
  NONE
  PERCENT
  FIXED
}

enum DeliveryStatus {
  PENDING
  SENT
  FAILED
}

enum PaymentSource {
  MANUAL
  CONFIRMATION
}

enum PaymentConfirmationStatus {
  PENDING
  CONFIRMED
  REJECTED
}

enum ReminderTone {
  FRIENDLY
  PROFESSIONAL
  FIRM
}

enum ReminderStatus {
  PENDING
  SENT
  FAILED
}

model Workspace {
  id                    String                @id @default(cuid())
  name                  String
  ownerId               String                @unique
  defaultCurrency       String                @default("PHP")
  timezone              String                @default("Asia/Manila")
  invoicePrefix         String                @default("INV-")
  nextInvoiceNumber     Int                   @default(1001)
  onboardingCompletedAt DateTime?
  owner                 User                  @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt
  members               WorkspaceMember[]
  auditLogs             AuditLog[]
  businessProfile       BusinessProfile?
  paymentInstructions   PaymentInstruction[]
  clients               Client[]
  productServices       ProductService[]
  invoices              Invoice[]
  invoiceEvents         InvoiceEvent[]
  deliveryAttempts      InvoiceDelivery[]
  payments              Payment[]
  paymentPromises       PaymentPromise[]
  paymentConfirmations  PaymentConfirmation[]
  reminderRules         ReminderRule[]
  reminders             InvoiceReminder[]
  expenseCategories     ExpenseCategory[]
  expenses              Expense[]
}

model ExpenseCategory {
  id          String    @id @default(cuid())
  workspaceId String
  name        String
  active      Boolean   @default(true)
  version     Int       @default(1)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  expenses    Expense[]

  @@unique([workspaceId, name])
  @@unique([workspaceId, id])
  @@index([workspaceId, active, name])
}

model Expense {
  id          String          @id @default(cuid())
  workspaceId String
  categoryId  String
  vendor      String
  description String
  amount      Decimal         @db.Decimal(19, 4)
  currency    String
  incurredOn  DateTime        @db.Date
  reference   String?
  notes       String?
  version     Int             @default(1)
  createdBy   String
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  workspace   Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  category    ExpenseCategory @relation(fields: [workspaceId, categoryId], references: [workspaceId, id], onDelete: Restrict)

  @@index([workspaceId, incurredOn, id])
  @@index([workspaceId, categoryId, incurredOn])
}

model ProductService {
  id          String    @id @default(cuid())
  workspaceId String
  name        String
  description String?
  unit        String
  price       Decimal   @db.Decimal(19, 4)
  taxable     Boolean   @default(true)
  active      Boolean   @default(true)
  version     Int       @default(1)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, active, name])
  @@index([workspaceId, createdAt])
}

model Client {
  id            String    @id @default(cuid())
  workspaceId   String
  name          String
  company       String?
  email         String
  phone         String?
  addressLine1  String?
  addressLine2  String?
  city          String?
  provinceState String?
  postalCode    String?
  country       String?
  taxId         String?
  currency      String?
  notes         String?
  archivedAt    DateTime?
  version       Int       @default(1)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  workspace     Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  invoices      Invoice[]

  @@unique([workspaceId, id])
  @@index([workspaceId, archivedAt, name])
  @@index([workspaceId, createdAt])
  @@index([workspaceId, email])
}

model Invoice {
  id                   String                @id @default(cuid())
  workspaceId          String
  clientId             String
  invoiceNumber        String
  issueDate            DateTime              @db.Date
  dueDate              DateTime              @db.Date
  currency             String
  status               InvoiceStatus         @default(DRAFT)
  clientName           String
  clientCompany        String?
  clientEmail          String
  clientAddress        String?
  subtotal             Decimal               @db.Decimal(19, 4)
  discountTotal        Decimal               @db.Decimal(19, 4)
  taxTotal             Decimal               @db.Decimal(19, 4)
  total                Decimal               @db.Decimal(19, 4)
  amountPaid           Decimal               @default(0) @db.Decimal(19, 4)
  balanceDue           Decimal               @db.Decimal(19, 4)
  notes                String?
  terms                String?
  paymentInstructions  String?
  calculationVersion   Int                   @default(1)
  version              Int                   @default(1)
  createdBy            String
  sentAt               DateTime?
  paidAt               DateTime?
  voidedAt             DateTime?
  issueSnapshot        Json?
  publicTokenHash      String?               @unique
  publicTokenExpiresAt DateTime?
  publicTokenRevokedAt DateTime?
  issuedAt             DateTime?
  emailSentAt          DateTime?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  workspace            Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  client               Client                @relation(fields: [workspaceId, clientId], references: [workspaceId, id], onDelete: Restrict)
  items                InvoiceItem[]
  events               InvoiceEvent[]
  deliveries           InvoiceDelivery[]
  payments             Payment[]
  paymentPromises      PaymentPromise[]
  paymentConfirmations PaymentConfirmation[]
  reminders            InvoiceReminder[]

  @@unique([workspaceId, invoiceNumber])
  @@unique([workspaceId, id])
  @@index([workspaceId, status, issueDate])
  @@index([workspaceId, clientId])
}

model ReminderRule {
  id          String            @id @default(cuid())
  workspaceId String
  offsetDays  Int
  label       String
  tone        ReminderTone
  subject     String
  message     String
  enabled     Boolean           @default(true)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  workspace   Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  reminders   InvoiceReminder[]

  @@unique([workspaceId, offsetDays])
  @@unique([workspaceId, id])
  @@index([workspaceId, enabled, offsetDays])
}

model InvoiceReminder {
  id            String         @id @default(cuid())
  workspaceId   String
  invoiceId     String
  ruleId        String?
  scheduledDate DateTime?      @db.Date
  recipient     String
  subject       String
  message       String
  tone          ReminderTone
  status        ReminderStatus @default(PENDING)
  manual        Boolean        @default(false)
  errorCode     String?
  attemptedAt   DateTime?
  sentAt        DateTime?
  createdBy     String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  workspace     Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  invoice       Invoice        @relation(fields: [workspaceId, invoiceId], references: [workspaceId, id], onDelete: Cascade)
  rule          ReminderRule?  @relation(fields: [workspaceId, ruleId], references: [workspaceId, id], onDelete: Restrict)

  @@unique([invoiceId, ruleId, scheduledDate])
  @@index([workspaceId, invoiceId, createdAt])
  @@index([workspaceId, status, createdAt])
}

model Payment {
  id                    String               @id @default(cuid())
  workspaceId           String
  invoiceId             String
  paymentConfirmationId String?              @unique
  amount                Decimal              @db.Decimal(19, 4)
  method                String
  reference             String?
  note                  String?
  paidAt                DateTime             @db.Date
  source                PaymentSource
  recordedBy            String?
  createdAt             DateTime             @default(now())
  workspace             Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  invoice               Invoice              @relation(fields: [workspaceId, invoiceId], references: [workspaceId, id], onDelete: Restrict)
  confirmation          PaymentConfirmation? @relation(fields: [workspaceId, paymentConfirmationId], references: [workspaceId, id], onDelete: Restrict)

  @@unique([workspaceId, paymentConfirmationId])
  @@index([workspaceId, invoiceId, paidAt])
  @@index([workspaceId, createdAt])
}

model PaymentPromise {
  id          String    @id @default(cuid())
  workspaceId String
  invoiceId   String
  promisedFor DateTime  @db.Date
  note        String?
  createdAt   DateTime  @default(now())
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  invoice     Invoice   @relation(fields: [workspaceId, invoiceId], references: [workspaceId, id], onDelete: Cascade)

  @@index([workspaceId, invoiceId, createdAt])
}

model PaymentConfirmation {
  id             String                    @id @default(cuid())
  workspaceId    String
  invoiceId      String
  idempotencyKey String
  amount         Decimal                   @db.Decimal(19, 4)
  method         String
  reference      String?
  message        String?
  paidAt         DateTime                  @db.Date
  status         PaymentConfirmationStatus @default(PENDING)
  reviewedBy     String?
  reviewedAt     DateTime?
  rejectionNote  String?
  createdAt      DateTime                  @default(now())
  updatedAt      DateTime                  @updatedAt
  workspace      Workspace                 @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  invoice        Invoice                   @relation(fields: [workspaceId, invoiceId], references: [workspaceId, id], onDelete: Cascade)
  payment        Payment?

  @@unique([invoiceId, idempotencyKey])
  @@unique([workspaceId, id])
  @@index([workspaceId, status, createdAt])
  @@index([workspaceId, invoiceId, createdAt])
}

model InvoiceEvent {
  id          String    @id @default(cuid())
  workspaceId String
  invoiceId   String
  type        String
  metadata    Json?
  createdAt   DateTime  @default(now())
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  invoice     Invoice   @relation(fields: [workspaceId, invoiceId], references: [workspaceId, id], onDelete: Cascade)

  @@index([workspaceId, invoiceId, createdAt])
}

model InvoiceDelivery {
  id          String         @id @default(cuid())
  workspaceId String
  invoiceId   String
  recipient   String
  subject     String
  message     String
  status      DeliveryStatus @default(PENDING)
  errorCode   String?
  attemptedAt DateTime?
  sentAt      DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  workspace   Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  invoice     Invoice        @relation(fields: [workspaceId, invoiceId], references: [workspaceId, id], onDelete: Cascade)

  @@index([workspaceId, invoiceId, createdAt])
  @@index([status, createdAt])
}

model InvoiceItem {
  id             String       @id @default(cuid())
  workspaceId    String
  invoiceId      String
  description    String
  unit           String
  quantity       Decimal      @db.Decimal(15, 4)
  unitPrice      Decimal      @db.Decimal(19, 4)
  discountType   DiscountType @default(NONE)
  discountValue  Decimal      @default(0) @db.Decimal(19, 4)
  taxRate        Decimal      @default(0) @db.Decimal(7, 4)
  subtotal       Decimal      @db.Decimal(19, 4)
  discountAmount Decimal      @db.Decimal(19, 4)
  taxAmount      Decimal      @db.Decimal(19, 4)
  lineTotal      Decimal      @db.Decimal(19, 4)
  sortOrder      Int
  createdAt      DateTime     @default(now())
  invoice        Invoice      @relation(fields: [workspaceId, invoiceId], references: [workspaceId, id], onDelete: Cascade)

  @@index([workspaceId, invoiceId, sortOrder])
}

model BusinessProfile {
  id                      String    @id @default(cuid())
  workspaceId             String    @unique
  displayName             String
  legalName               String?
  ownerName               String
  email                   String
  phone                   String?
  addressLine1            String
  addressLine2            String?
  city                    String
  provinceState           String?
  postalCode              String?
  country                 String
  website                 String?
  brandColor              String    @default("#285D45")
  logoData                Bytes?
  logoMimeType            String?
  invoiceFooter           String?
  defaultPaymentTermsDays Int       @default(30)
  defaultNotes            String?
  defaultTaxLabel         String    @default("Tax")
  defaultTaxRate          Decimal   @default(0) @db.Decimal(7, 4)
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt
  workspace               Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

model PaymentInstruction {
  id               String    @id @default(cuid())
  workspaceId      String
  name             String
  accountName      String?
  accountReference String?
  notes            String?
  enabled          Boolean   @default(true)
  sortOrder        Int
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  workspace        Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, name])
  @@index([workspaceId, sortOrder])
}

model WorkspaceMember {
  id          String    @id @default(cuid())
  workspaceId String
  userId      String
  role        Role      @default(STAFF)
  createdAt   DateTime  @default(now())
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([userId])
}

model AuditLog {
  id          String    @id @default(cuid())
  workspaceId String
  actorId     String
  action      String
  createdAt   DateTime  @default(now())
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict)

  @@index([workspaceId, createdAt])
}
